{
    "version": 9,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "installDir": "${sourceDir}/build/install",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            },
            "environment": {
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg/ports",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg/triplets"
            }
        },
        {
            "name": "msvc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_C_COMPILER": "cl"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "intelliSenseMode": "windows-msvc-x64",
                    "disableExternalAnalysis": true,
                    "enableClangTidyCodeAnalysis": false,
                    "enableMicrosoftCodeAnalysis": false,
                    "codeAnalysisRuleset": "CppCoreCheckRules.ruleset"
                }
            }
        },
        {
            "name": "x64",
            "hidden": true,
            "architecture": {
                "value": "x64",
                "strategy": "external"
            }
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "inherits": "debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Clang-cl 22.1.8 x86_64-pc-windows-msvc",
            "displayName": "Clang-cl 22.1.8 x86_64-pc-windows-msvc",
            "description": "Using compilers: C = F:\\dev\\llvm22\\bin\\clang-cl.exe, CXX = F:\\dev\\llvm22\\bin\\clang-cl.exe",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "F:/dev/llvm22/bin/clang-cl.exe",
                "CMAKE_CXX_COMPILER": "F:/dev/llvm22/bin/clang-cl.exe",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [],
    "testPresets": []
}